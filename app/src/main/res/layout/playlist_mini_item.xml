<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@color/day_white_and_night_dark">

    <ImageView
        android:id="@+id/imagePLMini"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginStart="@dimen/twelve_dp"
        android:src="@drawable/ic_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/namePLMini"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/eight_dp"
        android:layout_marginEnd="@dimen/eight_dp"
        android:ellipsize="marquee"
        android:fontFamily="@font/ys_display_regular"
        android:maxLines="1"
        android:textColor="@color/day_black_night_white"
        android:textFontWeight="400"
        android:textSize="@dimen/sixteen_dp"
        app:layout_constraintBottom_toTopOf="@id/tracksPLMini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imagePLMini"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Smells Like Teen Spirit Smells Like Teen Spirit Smells Like Teen Spirit" />


    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/tracksPLMini"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/eight_dp"
        android:layout_marginEnd="@dimen/eight_dp"
        app:constraint_referenced_ids="countPLMini"
        app:flow_firstHorizontalBias="0"
        app:flow_firstHorizontalStyle="packed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imagePLMini"
        app:layout_constraintTop_toBottomOf="@id/namePLMini" />

    <TextView
        android:id="@+id/countPLMini"
        style="@style/TrackItemUnderNameText"
        android:ellipsize="marquee"
        android:maxLines="1"
        tools:text=" треков" />
</androidx.constraintlayout.widget.ConstraintLayout>
