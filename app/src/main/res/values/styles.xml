<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ButtonStyleActivityMain" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dark_color</item>
        <item name="android:textSize">@dimen/twenty_four_sp</item>
        <item name="cornerRadius">@dimen/sixteen_dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/eight_dp</item>
        <item name="iconTint">@color/dark_color</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextStyleActivitySettingsWithIcon" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">@dimen/sixteen_dp</item>
        <item name="android:paddingVertical">@dimen/twenty_dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/sixteen_sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:drawableTint">@color/light_color_ic</item>
    </style>

    <style name="BackgroundMainActivity">
        <item name="android:background">@color/blue</item>
    </style>

    <style name="TextStyleTitleActivity" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginHorizontal">@dimen/twenty_four_dp</item>
        <item name="android:textSize">@dimen/twenty_four_sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/dark_color</item>
    </style>

    <style name="ArrowBackImageButtonActivityMain">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:src">@drawable/ic_arrowback</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:layout_marginStart">@dimen/sixteen_dp</item>
        <item name="tint">@color/dark_color</item>
    </style>

    <style name="TrackItemUnderNameText" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/eleven_sp</item>
        <item name="android:fontFamily">"@font/ys_display_regular"</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/day_gray_and_night_white</item>
        <item name="layout_constrainedWidth">true</item>
    </style>

    <style name="UnderDescriptionPL" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/eighteen_sp</item>
        <item name="android:fontFamily">"@font/ys_display_regular"</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/dark_color</item>
        <item name="layout_constrainedWidth">true</item>
    </style>

    <style name="ButtonStyleActivitySettings" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:backgroundTint">@color/day_dark_and_night_white</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/day_white_and_night_dark</item>
        <item name="android:textSize">@dimen/fourteen_sp</item>
        <item name="cornerRadius">@dimen/fifty_two</item>
    </style>

    <style name="ButtonStyleCreate" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/forty_four_dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:backgroundTint">@color/gray</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/sixteen_sp</item>
        <item name="cornerRadius">@dimen/eight_dp</item>
    </style>

    <style name="EditTextNewPL" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/sixteen_dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/day_black_night_white</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/sixteen_sp</item>
    </style>

    <style name="ClearImageButtonStyle" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:src">@drawable/ic_clear_button_16</item>
        <item name="tint">@color/day_black_night_white</item>
        <item name="android:layout_gravity">center|end</item>
        <item name="android:layout_marginEnd">@dimen/twelve_dp</item>
    </style>

    <style name="NameOfTrackData" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="android:fontFamily">"@font/ys_display_regular"</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/gray</item>
        <item name="layout_constrainedWidth">true</item>
    </style>

    <style name="TextItemPlaylist" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/twelve_sp</item>
        <item name="android:fontFamily">"@font/ys_display_regular"</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/day_black_night_white</item>
        <item name="layout_constrainedWidth">true</item>
    </style>

    <style name="TrackData" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:fontFamily">"@font/ys_display_regular"</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/day_dark_and_night_white</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="layout_constrainedWidth">true</item>
        <item name="layout_constraintHorizontal_bias">1</item>
    </style>

    <style name="BottomNavigationViewTextStyle" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">"@font/ys_display_regular"</item>
        <item name="android:textSize">@dimen/twelve_sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ToolbarTextStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">@dimen/twenty_four_sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/day_dark_and_night_white</item>
    </style>

</resources>