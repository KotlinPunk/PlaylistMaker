<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation_graph"
    app:startDestination="@id/mediaLibraryFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.practicum.playlistmaker.search.ui.search.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_audioplayerActivity"
            app:destination="@id/audioplayerActivity" />
    </fragment>
    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="com.practicum.playlistmaker.library.ui.frags.MediaLibraryFragment"
        android:label="MediaLibraryFragment"
        tools:layout="@layout/fragment_media_library">
        <action
            android:id="@+id/action_mediaLibraryFragment_to_newPlaylistFragment2"
            app:destination="@id/newPlaylistFragment" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_audioplayerActivity"
            app:destination="@id/audioplayerActivity" />
        <action
            android:id="@+id/action_mediaLibraryFragment_to_infoOfPlaylistsFragment"
            app:destination="@id/infoOfPlaylistsFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.practicum.playlistmaker.settings.ui.settings.SettingsFragment"
        android:label="SettingsFragment"
        tools:layout="@layout/fragment_settings"/>
    <activity
        android:id="@+id/audioplayerActivity"
        android:name="com.practicum.playlistmaker.player.ui.player.AudioplayerActivity"
        android:label="activity_audioplayer"
        tools:layout="@layout/activity_audioplayer" />
    <fragment
        android:id="@+id/favoriteFragment"
        android:name="com.practicum.playlistmaker.library.ui.frags.FavoriteFragment"
        android:label="FavoriteFragment"
        tools:layout="@layout/fragment_favorites">
        <action
            android:id="@+id/action_favoriteFragment_to_audioplayerActivity"
            app:destination="@id/audioplayerActivity" />
    </fragment>
    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.practicum.playlistmaker.library.ui.frags.PlaylistFragment"
        android:label="PlaylistFragment"
        tools:layout="@layout/fragment_playlist"/>
    <fragment
        android:id="@+id/newPlaylistFragment"
        android:name="com.practicum.playlistmaker.library.ui.frags.NewPlaylistFragment"
        android:label="fragment_new_playlist"
        tools:layout="@layout/fragment_new_playlist" />
    <fragment
        android:id="@+id/infoOfPlaylistsFragment"
        android:name="com.practicum.playlistmaker.library.ui.frags.InfoOfPlaylistsFragment"
        android:label="fragment_list_of_playlists"
        tools:layout="@layout/fragment_info_of_playlists">
        <action
            android:id="@+id/action_infoOfPlaylistsFragment_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
    </fragment>

</navigation>